{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/check-setup.ps1"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/guard.ps1"]
          }
        ]
      }
    ]
  }
}